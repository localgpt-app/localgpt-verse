// Cloudflare Worker config for the LocalGPT Verse site.
// Static assets only — no Worker script, nothing to build. Deploy with
// scripts/publish-site.sh (or `npx wrangler deploy` from this directory).
{
  "name": "localgpt-verse",
  "compatibility_date": "2026-09-21",
  "assets": {
    // Serve this directory as-is.
    "directory": ".",
    // /docs serves docs/index.html; .html extensions are dropped.
    "html_handling": "auto-trailing-slash",
    // No 404.html in the site — unmatched paths get a plain 404.
    "not_found_handling": "none"
  }
}
